FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY turbo.json ./
COPY apps/api/package*.json ./apps/api/
COPY packages/shared/package*.json ./packages/shared/

# Install dependencies
RUN npm install

# Copy source
COPY apps/api ./apps/api
COPY packages/shared ./packages/shared

# Generate Prisma client
RUN npm run db:generate --workspace=@linguamentor/api

# Build
RUN npm run build --workspace=@linguamentor/api

EXPOSE 4000

CMD ["npm", "start", "--workspace=@linguamentor/api"]
